<Window x:Class="DriveClub.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DriveClub.Launcher" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" FontFamily="{DynamicResource BodyFont}" FontSize="14" Title="DRIVECLUB Launcher" Icon="Assets/app.ico" Width="1282" Height="862" MinWidth="1030" MinHeight="662" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="#111114" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowBorder" BorderBrush="#393940" BorderThickness="1" Background="#111114">
    <Grid x:Name="Root">
      <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/><RowDefinition Height="76"/></Grid.RowDefinitions>
      <Grid x:Name="BackgroundHolder" Grid.RowSpan="3" Margin="228,0,0,0" ClipToBounds="True" IsHitTestVisible="False"/>
      <local:FilmGrainOverlay Grid.RowSpan="3" Margin="228,0,0,0"/>
      <Border Grid.RowSpan="3" Width="228" HorizontalAlignment="Left" BorderBrush="#393940" BorderThickness="0,0,1,0" Background="#111111" IsHitTestVisible="False"/>
      <Grid Grid.Row="0" Panel.ZIndex="10" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Image x:Name="TitleLogo" Grid.Column="0" Width="196" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <TextBlock Grid.Column="1" Text="PC LAUNCHER" Foreground="#8B93A1" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Width="52" Height="42" VerticalAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent" Click="MinimizeClick" ToolTip="Minimize"><local:DottedCaptionGlyph Fill="#DDDDDD" Width="16" Height="16"><local:DottedCaptionGlyph.Style><Style TargetType="{x:Type local:DottedCaptionGlyph}"><Setter Property="Glyph" Value="Minimize"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True"><Setter Property="Glyph" Value="TriangleDown"/></DataTrigger></Style.Triggers></Style></local:DottedCaptionGlyph.Style></local:DottedCaptionGlyph></Button>
          <Button x:Name="MaximizeButton" Width="52" Height="42" VerticalAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent" Click="MaximizeClick" ToolTip="Maximize or restore"><local:DottedCaptionGlyph x:Name="MaximizeGlyph" Glyph="Maximize" Fill="#DDDDDD" Width="16" Height="16"/></Button>
          <Button x:Name="CloseButton" Width="52" Height="42" VerticalAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent" Click="CloseClick" ToolTip="Close"><local:DottedCaptionGlyph Glyph="Close" Fill="#ED2B38" Width="16" Height="16"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="Transparent"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="16"/></Grid.RowDefinitions>

          <ScrollViewer x:Name="SidebarMenuHost" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
            <Grid VerticalAlignment="Center" Margin="16,0">
              <Border x:Name="NavigationSelection" Height="38" VerticalAlignment="Top" Background="#ED2B38" Visibility="Collapsed" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="NavigationSelectionTransform"/></Border.RenderTransform></Border>
              <StackPanel x:Name="Navigation" VerticalAlignment="Center"/>
            </Grid>
          </ScrollViewer>
        </Grid></Border>
        <Grid Grid.Column="1" ClipToBounds="True"><Grid x:Name="PageHolder"/></Grid>
      </Grid>
      <Border x:Name="FooterFrame" Grid.Row="2" BorderThickness="0" Background="Transparent"><Grid Margin="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition x:Name="FooterPlayColumn" Width="184"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
        <Button x:Name="ResetButton" Style="{StaticResource FieldButton}" Grid.Column="1" Content="Reset this page" ToolTip="Restore defaults for this page only. Other pages and game folders are kept." Height="40" Click="ResetClick" Padding="20,0" FontSize="13"/>
        <TextBlock x:Name="Status" Grid.Column="3" Text="Loading your settingsвЂ¦" Foreground="#8B93A1" Margin="20,8,18,8" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
        <Button x:Name="SaveButton" Style="{StaticResource FieldButton}" Grid.Column="2" Margin="18,0,0,0" Content="Save settings" Height="40" Click="SaveClick" Padding="20,0" FontSize="13"/>
        <Button x:Name="FooterPlay" Grid.Column="4" Content="PLAY" Height="42" Margin="18,0,0,0" Click="PlayClick" Style="{StaticResource PlayButton}" FontSize="14"/>
      </Grid></Border>
      <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="5" Background="#101014" Visibility="Collapsed">
        <Image x:Name="BusyArt" Stretch="UniformToFill"/>
        <Rectangle x:Name="BusyDim" Fill="{StaticResource ArtworkDim}"/>
        <local:FilmGrainOverlay/>
        <TextBlock Text="PREPARING YOUR DRIVE" FontFamily="{DynamicResource HeadingFont}" FontSize="30" Margin="58,118,30,0" VerticalAlignment="Top"/>
        <Grid x:Name="SwipeLayer" Opacity="1" IsHitTestVisible="False"><Image x:Name="SwipeOne" Opacity="0" Stretch="Fill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TranslateTransform/></Image.RenderTransform></Image><Image x:Name="SwipeTwo" Opacity="0" Stretch="Fill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><TransformGroup><RotateTransform Angle="180"/><TranslateTransform/></TransformGroup></Image.RenderTransform></Image><Image x:Name="Stamp" Opacity="0" Width="190" Height="285" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform/></Image.RenderTransform></Image></Grid>
        <Grid VerticalAlignment="Bottom" Margin="58,0,58,50"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="20"/><RowDefinition Height="30"/></Grid.RowDefinitions><TextBlock x:Name="ProgressText" Text="Preparing game filesвЂ¦" FontSize="16" VerticalAlignment="Center" Margin="0,0,100,0" TextWrapping="Wrap"/><Image x:Name="Spinner" Width="64" Height="64" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform/></Image.RenderTransform></Image><ProgressBar x:Name="Progress" Grid.Row="1" Minimum="0" Maximum="100"/><TextBlock x:Name="PercentText" Grid.Row="2" Text="0%" HorizontalAlignment="Right" FontFamily="{DynamicResource HeadingFont}"/></Grid>
      </Grid>
    </Grid>
  </Border>
</Window>

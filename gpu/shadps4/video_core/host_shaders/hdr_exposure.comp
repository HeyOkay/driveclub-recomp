// bbport: HDR output (HostPasses::HdrPass): how bright the game's linear scene is against its SDR
// picture. Over a 64x64 grid of the picture before the UI, the mean log ratio of their
// luminances where the SDR picture is in its mid tones (its tone mapping is near linear there);
// smoothed over frames in `state` (0: no value yet).
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D sdr_tex;    // sRGB encoded values (UNORM)
layout(binding = 1) uniform sampler2D scene_tex;  // linear HDR
layout(binding = 2, r32f) uniform image2D state;  // (0, 0): SDR white per scene unit

shared float partial_sum[256];
shared float partial_count[256];

const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);

vec3 ToLinear(vec3 c) {
    return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lessThan(c, vec3(0.04045)));
}

void main() {
    const uint id = gl_LocalInvocationIndex;
    float sum = 0.0, count = 0.0;
    for (uint j = 0; j < 4; ++j) {
        for (uint i = 0; i < 4; ++i) {
            const vec2 uv = (vec2(gl_LocalInvocationID.xy * 4u + uvec2(i, j)) + 0.5) / 64.0;
            const float ys = dot(ToLinear(textureLod(sdr_tex, uv, 0.0).rgb), kLuma);
            const float yh = dot(max(textureLod(scene_tex, uv, 0.0).rgb, vec3(0.0)), kLuma);
            if (ys > 0.02 && ys < 0.5 && yh > 1e-5) {
                sum += log(ys / yh);
                count += 1.0;
            }
        }
    }
    partial_sum[id] = sum;
    partial_count[id] = count;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (id < stride) {
            partial_sum[id] += partial_sum[id + stride];
            partial_count[id] += partial_count[id + stride];
        }
        barrier();
    }
    if (id == 0 && partial_count[0] >= 32.0) {
        const float k = exp(partial_sum[0] / partial_count[0]);
        const float old = imageLoad(state, ivec2(0)).r;
        imageStore(state, ivec2(0), vec4(old > 0.0 ? mix(old, k, 0.1) : k));
    }
}
